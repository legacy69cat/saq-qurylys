{
  "name": "saq-qurylys",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24.15.0 <25"
  },
  "scripts": {
    "dev": "next dev --hostname 127.0.0.1",
    "build": "next build",
    "start": "next start --hostname 127.0.0.1",
    "lint": "eslint .",
    "typecheck": "next typegen && tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "npm run build && playwright test",
    "db:migrate": "node --import tsx --env-file-if-exists=.env.local scripts/database.ts migrate",
    "db:seed": "node --import tsx --env-file-if-exists=.env.local scripts/database.ts seed",
    "db:setup": "node --import tsx --env-file-if-exists=.env.local scripts/database.ts setup",
    "check": "npm run lint && npm run typecheck && npm test && npm run build",
    "test:ai:live": "node --import tsx --env-file-if-exists=.env.local scripts/evaluate-ai.ts",
    "collect:social": "node --import tsx --env-file-if-exists=.env.local scripts/collect-social.ts",
    "db:import": "node --import tsx --env-file-if-exists=.env.local scripts/import-projects.ts",
    "test:auth": "playwright test -c playwright.auth.config.ts",
    "users": "node --import tsx --env-file-if-exists=.env.local scripts/users.ts",
    "telegram:setup": "node --import tsx --env-file-if-exists=.env.local scripts/setup-telegram.ts",
    "demo": "node --import tsx --env-file-if-exists=.env.local scripts/case-demo.ts",
    "verify:case": "node --import tsx scripts/case-demo.ts --verify",
    "test:case:live": "node --env-file-if-exists=.env.local node_modules/@playwright/test/cli.js test -c playwright.case.config.ts"
  },
  "dependencies": {
    "@libsql/client": "^0.18.0",
    "ai": "7.0.143",
    "leaflet": "1.9.4",
    "next": "16.4.0",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "server-only": "0.0.1",
    "sharp": "^0.35.5"
  },
  "devDependencies": {
    "@eslint/js": "9.39.5",
    "@playwright/test": "1.64.1",
    "@types/leaflet": "1.9.22",
    "@types/node": "24.19.2",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "eslint": "9.39.5",
    "eslint-plugin-jsx-a11y": "6.10.2",
    "eslint-plugin-react-hooks": "7.1.1",
    "tsx": "4.23.15",
    "typescript": "6.0.3",
    "typescript-eslint": "8.71.2",
    "vitest": "5.0.4"
  }
}
