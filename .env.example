# Local SQLite; initialize or upgrade with npm run db:setup.
DATABASE_PATH=./data/saq.sqlite
# Server-only credentials. Never commit .env.local or use NEXT_PUBLIC_ for secrets.
AI_GATEWAY_API_KEY=
# Set a current provider/model ID from https://ai-gateway.vercel.sh/v1/models
AI_GATEWAY_MODEL=

# Apify token for public social monitoring (server/worker only)
APIFY_TOKEN=

# Optional replacement HTTPS Photon endpoint. Default: https://photon.komoot.io/api/
PHOTON_API_URL=

# Local development only. Production uses SAQ_AUTH_MODE=session, APP_ENV=production.
SAQ_AUTH_MODE=local
APP_ENV=local

# Vision-capable Gateway model; enable only with configured AI_GATEWAY_API_KEY
DRONE_AI_MODEL=

# Telegram citizen bot
TELEGRAM_BOT_TOKEN=
TELEGRAM_WEBHOOK_SECRET=

# Cloud production only: separate database and credentials for each environment.
TURSO_DATABASE_URL=
TURSO_AUTH_TOKEN=
APP_URL=http://127.0.0.1:3000
SAQ_DEMO_MODE=0
CRON_SECRET=
APIFY_WEBHOOK_SECRET=

# Show explicitly marked fictional projects without enabling demo mode.
SAQ_SHOW_SIMULATIONS=0
